{% extends "_base/class.html.jinja" %}

{#- Link to the source code on GitHub instead of embedding it. -#}
{% block source scoped %}
  {% if config.show_source and class.relative_filepath and class.lineno %}
    <p class="cy-source-link">
      <a href="https://github.com/LiamMcAllisterGroup/cytools/blob/main/{{ class.relative_filepath.as_posix() }}#L{{ class.lineno }}">Source on GitHub</a>
    </p>
  {% endif %}
{% endblock source %}
