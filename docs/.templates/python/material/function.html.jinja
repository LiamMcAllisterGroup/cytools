{% extends "_base/function.html.jinja" %}

{#- Link to the source code on GitHub instead of embedding it. -#}
{% block source scoped %}
  {% if config.show_source and function.relative_filepath and function.lineno %}
    <p class="cy-source-link">
      <a href="https://github.com/LiamMcAllisterGroup/cytools/blob/main/{{ function.relative_filepath.as_posix() }}#L{{ function.lineno }}-L{{ function.endlineno or function.lineno }}">Source on GitHub</a>
    </p>
  {% endif %}
{% endblock source %}
